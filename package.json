{
  "name": "queuepilot",
  "version": "0.16.1",
  "description": "Local-first, API-first antidetect browser profile orchestrator",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format:check": "prettier --check .",
    "dev": "npm run dev -w apps/api",
    "start": "npm run start -w apps/api",
    "build:release": "node scripts/build-release.mjs",
    "build:release:tester": "node scripts/build-release.mjs --tester"
  },
  "devDependencies": {
    "javascript-obfuscator": "^4.1.1",
    "prettier": "^3.4.2"
  }
}
