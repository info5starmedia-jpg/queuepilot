# QueuePilot team server — production image.
#
# Build (from the repo root):
#   docker build -f deploy/Dockerfile.server -t queuepilot-server .
# Run (see deploy/docker-compose.yml — compose is the supported path):
#   docker compose -f deploy/docker-compose.yml up -d
#
# Two stages: compile TS with dev deps, then run dist/ on a slim runtime.
# node:24-slim (glibc) is deliberate: better-sqlite3 and @node-rs/argon2
# ship prebuilt binaries for linux-x64-gnu; alpine/musl would compile from
# source and slow/break the build.

FROM node:24-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
RUN npm ci --workspace apps/server
COPY apps/server apps/server
RUN npm run build -w apps/server

FROM node:24-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/server/package.json apps/server/
RUN npm ci --workspace apps/server --omit=dev

FROM node:24-slim
ENV NODE_ENV=production \
    QUEUEPILOT_TEAM_HOST=0.0.0.0 \
    QUEUEPILOT_TEAM_PORT=3010 \
    QUEUEPILOT_TEAM_DB=/app/data/team-server.db
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build /app/apps/server/dist ./apps/server/dist
COPY apps/server/package.json ./apps/server/package.json
COPY package.json ./package.json
RUN mkdir -p /app/data && chown -R node:node /app/data
USER node
VOLUME ["/app/data"]
EXPOSE 3010
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD node -e "fetch('http://127.0.0.1:3010/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/server/dist/main.js"]
