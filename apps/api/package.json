{
  "name": "@queuepilot/api",
  "version": "0.12.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && node --input-type=module -e \"import fs from 'node:fs'; fs.cpSync('src/dashboard', 'dist/dashboard', { recursive: true })\"",
    "test": "vitest run",
    "verify": "tsx verify/run.ts",
    "verify:calibrate": "tsx verify/calibrate-stock-chrome.ts"
  },
  "dependencies": {
    "@queuepilot/client": "*",
    "@queuepilot/contracts": "*",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
